{
  "name": "@scope/my-lib",
  "version": "0.1.0",
  "description": "TODO: one line about what my-lib does",
  "keywords": [
    "vue",
    "vue3",
    "components"
  ],
  "license": "MIT",
  "author": "Pvngu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pvngu/my-lib.git"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/my-lib.umd.cjs",
  "module": "./dist/my-lib.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/my-lib.iife.js",
  "jsdelivr": "./dist/my-lib.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/my-lib.es.js",
      "require": "./dist/my-lib.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode umd",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0 && node scripts/check-class-prefix.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run check",
    "rename": "node scripts/rename.mjs"
  },
  "peerDependencies": {
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
